{
  "name": "css-art",
  "private": true,
  "description": "Development tooling only. Nothing here ships inside a piece.",
  "scripts": {
    "lint:css": "stylelint \"pieces/**/*.css\"",
    "lint:html": "html-validate \"pieces/**/*.html\"",
    "lint:python": "pylint tools && yapf --diff --recursive tools",
    "lint": "npm run lint:css && npm run lint:html && npm run lint:python",
    "check:pieces": "python3 tools/check_pieces.py"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.3.1",
    "html-validate": "^11.16.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2"
  }
}
